<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:settings="clr-namespace:Raisin.WPF.Base.Settings"
                    xmlns:behaviors="clr-namespace:Raisin.WPF.Base.Behaviors">

    <BooleanToVisibilityConverter x:Key="SettingsBoolToVis"/>

    <!-- Shared style for the setting row wrapper -->
    <Style x:Key="SettingRowBorder" TargetType="Border">
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="Margin" Value="0,1"/>
        <Setter Property="BorderThickness" Value="2,0,0,0"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsModified}" Value="True">
                <Setter Property="BorderBrush" Value="Teal"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Compact reset button style — always visible, disabled when the value is at its default.

         The template is spelled out here rather than chained to SharedThemeCore's SmallButton
         via BasedOn: this dictionary is merged into a consuming Window/UserControl's Resources,
         and a StaticResource reaching out of it resolves against whatever that consumer happens
         to have in scope. Keeping it self-contained also avoids injecting SharedThemeCore's
         implicit styles into consumers that theme with MaterialDesign. Colours therefore mirror
         SharedThemeCore's SurfaceButton / SurfaceButtonHover / Border tokens as literals.

         Note the style MUST supply a Template. Without one it does not inherit the implicit
         Button style — an explicit style replaces the implicit one outright — so the button
         falls back to the default Aero chrome and renders light grey on a dark settings pane. -->
    <Style x:Key="SettingsResetButton" TargetType="Button">
        <Setter Property="Content" Value="Reset"/>
        <Setter Property="Padding" Value="6,2"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="Margin" Value="8,0,0,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Background" Value="#333337"/>
        <Setter Property="Foreground" Value="#CCCCCC"/>
        <Setter Property="BorderBrush" Value="#3F3F46"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="IsEnabled" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            CornerRadius="2"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#454549"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#7EB4EA"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#505054"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#555555"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#569DE5"/>
                        </Trigger>
                        <!-- At default: recede, but stay legible. The old style dimmed the whole
                             button to 0.25 opacity, which is invisible on a #1E1E1E ground. -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="#2A2A2C"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#333333"/>
                            <Setter Property="Foreground" Value="#6E6E6E"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsModified}" Value="True">
                <Setter Property="IsEnabled" Value="True"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Category Header -->
    <DataTemplate x:Key="SharedCategoryHeaderTemplate" DataType="{x:Type settings:CategoryHeaderItem}">
        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" Margin="0,16,0,4"/>
    </DataTemplate>

    <!-- Bool -->
    <DataTemplate x:Key="SharedBoolTemplate" DataType="{x:Type settings:BoolSettingItem}">
        <Border Style="{StaticResource SettingRowBorder}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource SettingsResetButton}"
                        Command="{Binding ResetCommand}"/>
                <StackPanel>
                    <DockPanel>
                        <TextBlock Text="{Binding Key}" FontFamily="Consolas" FontSize="10"
                                   Opacity="0.4" VerticalAlignment="Center" Margin="8,0,0,0"
                                   DockPanel.Dock="Right"/>
                        <CheckBox IsChecked="{Binding Value}" Content="{Binding DisplayName}" FontWeight="SemiBold"/>
                    </DockPanel>
                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Opacity="0.6"
                               FontSize="11" Margin="0,2,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </DataTemplate>

