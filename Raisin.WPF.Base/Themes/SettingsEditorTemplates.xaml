                    <ComboBox ItemsSource="{Binding Choices}"
                              SelectedItem="{Binding SelectedValue}"
                              Width="100" HorizontalAlignment="Left" Margin="0,4,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </DataTemplate>

