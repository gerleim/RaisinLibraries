<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <!-- SharedTheme = SharedThemeCore + full MaterialDesign2.Defaults.
         SharedThemeCore has standalone dark styles for DataGrid/Button that work without MD Defaults.
         This file upgrades them to the full MD versions (Ripple, sort animations, etc.).
         Apps that don't need MD control styles can use SharedThemeCore.xaml directly for faster startup. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="SharedThemeCore.xaml" />
        <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign2.Defaults.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- MD-enhanced overrides: these replace the standalone versions from SharedThemeCore -->
    <Style x:Key="CompactButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
        <Setter Property="Padding" Value="12,2" />
        <Setter Property="RenderTransform">
            <Setter.Value>
                <TranslateTransform Y="2"/>
            </Setter.Value>
        </Setter>
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Height" Value="Auto" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="4" />
        <Setter Property="Opacity" Value="0.85" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Opacity" Value="1.0" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="DataGrid" BasedOn="{StaticResource MaterialDesignDataGrid}">
        <Setter Property="RowHeight" Value="22"/>
    </Style>
    <Style TargetType="DataGridCell" BasedOn="{StaticResource MaterialDesignDataGridCell}">
        <Setter Property="Padding" Value="4,1"/>
    </Style>
    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
        <Setter Property="Padding" Value="4,2"/>
    </Style>

</ResourceDictionary>
