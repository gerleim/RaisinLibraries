<UserControl x:Class="Raisin.WPF.Base.Settings.SettingsListControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:settings="clr-namespace:Raisin.WPF.Base.Settings">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="130"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Category sidebar -->
        <ListBox x:Name="CategoryListBox"
                 BorderThickness="0" Background="Transparent"
                 SelectionChanged="OnCategorySidebarSelection">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" Padding="6,4" FontSize="12"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Background" Value="Transparent"/>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>

        <!-- Right panel: search + settings list -->
        <DockPanel Grid.Column="1" Margin="8,0,0,0">
            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                <TextBox x:Name="SearchBox"
                         Text="{Binding SearchText, RelativeSource={RelativeSource AncestorType={x:Type settings:SettingsListControl}}, UpdateSourceTrigger=PropertyChanged}"
                         Padding="6,4" Background="#2D2D2D" Foreground="#D4D4D4"
                         BorderBrush="#3E3E3E" FontSize="12"
                         TextChanged="OnSearchTextChanged"/>
                <TextBlock x:Name="SearchWatermark"
                           Text="Search settings..." IsHitTestVisible="False"
                           Foreground="#808080" FontStyle="Italic"
                           Padding="8,5" FontSize="12"/>
            </Grid>

            <ScrollViewer x:Name="SettingsScrollViewer"
                          VerticalScrollBarVisibility="Auto"
                          ScrollChanged="OnScrollChanged">
                <ItemsControl x:Name="SettingsItemsControl"/>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</UserControl>
